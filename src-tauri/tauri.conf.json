{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ddraw",
  "version": "0.1.0",
  "identifier": "com.ddraw.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ddraw",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#171B24"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Hand-drawn-style whiteboard",
    "longDescription": "A fast, hand-drawn-style whiteboard for sketching diagrams, wireframes, and ideas, with optional real-time collaboration.",
    "fileAssociations": [
      {
        "ext": ["ddraw"],
        "name": "Ddraw Drawing",
        "description": "Ddraw drawing",
        "mimeType": "application/x-ddraw",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
